PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=replace-with-a-strong-password

# Upstash Redis for persistent data storage on Vercel (added automatically by the Vercel
# Storage integration). Leave empty locally: the app then uses data.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative Upstash env vars (also supported):
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob token required for persistent file uploads on Vercel
BLOB_READ_WRITE_TOKEN=

# Optional: enables the "Forgot password?" link on /admin without needing an email
# service. Set this to a long random string and keep it private -- anyone who has it
# can set a brand-new admin password. Leave unset to disable the recovery link.
ADMIN_RECOVERY_CODE=

# Optional: email alert when a visitor submits the contact form. Get a free API key
# at https://resend.com (no card required, 100 emails/day free). Leave both unset to
# disable -- the contact form still works, it just won't email you.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Optional: only needed once you verify your own domain in Resend; otherwise the
# shared address below works without any setup.
# RESEND_FROM=PhoenixAI Studio <onboarding@resend.dev>
